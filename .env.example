# Copy this file to .env and fill in what you use. Everything is optional
# except the AI choice, which defaults to the Claude Code CLI.

# ---------- Which AI writes the drafts ----------
# claude-cli         The Claude Code CLI, signed in on this computer (default).
#                    No API key. Uses your Claude plan.
# anthropic          The Anthropic API. Needs ANTHROPIC_API_KEY and
#                    `pip install anthropic`.
# openai-compatible  OpenAI, Ollama, LM Studio, or any server with the OpenAI
#                    chat API. Needs LLM_BASE_URL and LLM_MODEL.
LLM_PROVIDER=claude-cli

# anthropic only
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# openai-compatible only. Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o   LLM_API_KEY=sk-...
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
#   LM Studio:  LLM_BASE_URL=http://localhost:1234/v1    LLM_MODEL=<the model you loaded>
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# claude-cli only: where the claude command is, if Verbatim cannot find it.
# CLAUDE_BIN=

# ---------- Server ----------
# The port the server listens on. The Chrome extension's settings must match.
# PORT=5053

# ---------- Your notes ----------
# A plain folder of Markdown files: your saved answers, story bank, voice
# note and interview notes. Defaults to ./notes in this folder.
# NOTES_DIR=

# Obsidian users: point at your vault instead. Verbatim's notes then go in
# a "Job Search" folder inside it (OBSIDIAN_FOLDER changes that name).
# OBSIDIAN_VAULT=
# OBSIDIAN_FOLDER=Job Search
# Optional: go through the Obsidian Local REST API plugin instead of the
# files. Settings -> Local REST API for the key.
# OBSIDIAN_API_KEY=

# ---------- Optional extras ----------
# Chrome or Chromium for making PDFs, if Verbatim cannot find it.
# CHROME_PATH=

# Your resume PDF, if profile.json's resume_pdf path is not right here.
# RESUME_PDF=

# Samples of your own writing for drafts to sound like you (see voicesamples.py).
# VOICE_SAMPLE_NOTES=Some note I wrote.md, Another note.md
# PORTFOLIO_DIR=~/my-portfolio-site
# PORTFOLIO_FILES=case-study-one.html, case-study-two.html

# The mic button (needs whisper-cli and ffmpeg installed, and a model file).
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# WHISPER_MODEL=./models/ggml-small.en.bin
# WHISPER_HINT=Names whisper should expect, like your employers and tools.

# Job board: Google Jobs search through SerpApi (serpapi_jobs in jobs/config.json).
# SERPAPI_KEY=

# How other devices reach this server, if you open Verbatim from more than one.
# PUBLIC_BASE=
